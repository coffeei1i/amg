<mxfile host="app.diagrams.net" agent="Codex" version="26.0.9" pages="1">
  <diagram id="brs-map-final" name="BRS-Map final workflow">
    <mxGraphModel dx="1800" dy="560" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1800" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="BRS-Map: evidence-aware behavioral-response score mapping" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=26;fontStyle=1;fontColor=#17212B;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="42" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Cell-type-resolved programs to snRNA &amp;#8594; Stereo-seq CellBins" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#59636E;" vertex="1" parent="1"><mxGeometry x="42" y="60" width="760" height="28" as="geometry"/></mxCell>
        <mxCell id="inputs" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;1  Harmonized inputs&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;7 retained datasets&lt;br&gt;48 post-QC objects&lt;br&gt;16 prespecified contrasts&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Raw counts + condition +&lt;br&gt;experimental_unit_id&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EEF4F3;strokeColor=#476A75;strokeWidth=2;fontFamily=Arial;fontSize=13;verticalAlign=top;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="40" y="115" width="185" height="270" as="geometry"/></mxCell>
        <mxCell id="identity" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;2  Identity mapping&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;One anchor set&lt;br&gt;One 49-type transfer&lt;br&gt;One UMAP projection&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;primary &amp;#8805; 0.50&lt;br&gt;sensitivity 0.30&amp;#8211;&amp;lt;0.50&lt;br&gt;feature coverage &amp;#8805; 0.70&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EEF4F3;strokeColor=#476A75;strokeWidth=2;fontFamily=Arial;fontSize=13;verticalAlign=top;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="245" y="115" width="205" height="270" as="geometry"/></mxCell>
        <mxCell id="evidence" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;3  Evidence + program&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Sample: &lt;/b&gt;formal / low-power / descriptive&lt;br&gt;&lt;b&gt;Genes: &lt;/b&gt;FDR signature / top-20 fallback (*)&lt;br&gt;&lt;b&gt;Identity: &lt;/b&gt;primary / sensitivity (S)&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Pseudobulk by independent unit &amp;#215; Celltype&lt;br&gt;&amp;#8805;20 cells per retained unit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF3DC;strokeColor=#A66B1E;strokeWidth=2;fontFamily=Arial;fontSize=13;verticalAlign=top;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="470" y="115" width="250" height="270" as="geometry"/></mxCell>
        <mxCell id="ucell" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;4  Signed score&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;UCell up program&lt;br&gt;minus&lt;br&gt;UCell down program&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;maxRank = 1,500&lt;br&gt;&amp;#8805;10 mapped genes&lt;br&gt;per direction&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF3DC;strokeColor=#A66B1E;strokeWidth=2;fontFamily=Arial;fontSize=13;verticalAlign=top;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="740" y="115" width="175" height="270" as="geometry"/></mxCell>
        <mxCell id="round1" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;5  Round 1&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;External cells &amp;#8594; snRNA&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Exact Celltype&lt;br&gt;PCs 1&amp;#8211;30; k = 20&lt;br&gt;source &amp;#8805; 100 cells&lt;br&gt;unit-balanced&lt;br&gt;weighted-kNN&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EDF2FA;strokeColor=#476FA8;strokeWidth=2;fontFamily=Arial;fontSize=13;verticalAlign=top;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="935" y="115" width="180" height="270" as="geometry"/></mxCell>
        <mxCell id="round2" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;6  Round 2&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;snRNA &amp;#8594; Stereo-seq&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Exact Celltype&lt;br&gt;PCs 1&amp;#8211;30; k = 20&lt;br&gt;reference &amp;#8805; 100 cells&lt;br&gt;same weighted-kNN&lt;br&gt;CellBin output&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EDF2FA;strokeColor=#476FA8;strokeWidth=2;fontFamily=Arial;fontSize=13;verticalAlign=top;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="1135" y="115" width="180" height="270" as="geometry"/></mxCell>
        <mxCell id="direction" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;7  Final audit&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Keep only same-sign&lt;br&gt;Round 1 and Round 2&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Reversal / zero / failure &amp;#8594; NA&lt;br&gt;primary-first; sensitivity&lt;br&gt;fills only missing primary&lt;br&gt;markers: S, *, S*&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FBEDEC;strokeColor=#B35A52;strokeWidth=2;fontFamily=Arial;fontSize=13;verticalAlign=top;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="1335" y="115" width="200" height="270" as="geometry"/></mxCell>
        <mxCell id="readouts" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;8  Final readouts&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;41 neuronal types only&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Celltype landscape&lt;/b&gt;&lt;br&gt;scale cells, then mean&lt;br&gt;&lt;br&gt;&lt;b&gt;Spatial programs&lt;/b&gt;&lt;br&gt;joint M1&amp;#8211;M3 Q95 scaling&lt;br&gt;&lt;br&gt;&lt;b&gt;Subnuclei&lt;/b&gt;&lt;br&gt;pooled directional balance" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EDF6EA;strokeColor=#4C7A52;strokeWidth=2;fontFamily=Arial;fontSize=13;verticalAlign=top;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="1555" y="115" width="205" height="270" as="geometry"/></mxCell>
        <mxCell id="edge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#59636E;" edge="1" parent="1" source="inputs" target="identity"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#59636E;" edge="1" parent="1" source="identity" target="evidence"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#59636E;" edge="1" parent="1" source="evidence" target="ucell"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#59636E;" edge="1" parent="1" source="ucell" target="round1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#59636E;" edge="1" parent="1" source="round1" target="round2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#59636E;" edge="1" parent="1" source="round2" target="direction"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#59636E;" edge="1" parent="1" source="direction" target="readouts"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="footnote" value="All thresholds and NA reasons are exported in audit tables. Stereo AP order: UNRESOLVED_DO_NOT_GUESS." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#59636E;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="320" y="425" width="1160" height="30" as="geometry"/></mxCell>
        <mxCell id="formula" value="Spatial scaling: clip(raw / Q0.95(|raw across M1&amp;#8211;M3|), &amp;#8722;1, 1)    |    Subnuclear balance: (positive &amp;#8722; negative) / (positive + negative)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F7F9FA;strokeColor=#B8C1C8;strokeWidth=1;fontFamily=Arial;fontSize=13;fontColor=#303B44;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="470" width="1200" height="50" as="geometry"/></mxCell>
      </root>
